# Copy this file to playground/.env for npm run dev.
# Set the same variables in the FRONTEND Vercel project for production.

# Cloud sync: these values stay on the frontend server, never in NUXT_PUBLIC_*.
BUDGETYAR_BACKEND_URL=https://jalali-date-picker.vercel.app
# Must exactly match BUDGETYAR_API_TOKEN in the backend Vercel project (32+ characters).
BUDGETYAR_API_TOKEN=CHANGE_ME
# User-facing cloud login password (16+ characters).
BUDGETYAR_CLOUD_PASSWORD=CHANGE_ME
# Separate random cookie-signing secret (32+ characters).
BUDGETYAR_SESSION_SECRET=CHANGE_ME

# Optional financial analysis, used only by the server API.
GAPGPT_API_KEY=
GAPGPT_MODEL=gpt-4o

# Optional market rates key. This value is exposed to the browser by Nuxt.
NUXT_PUBLIC_BRS_API_KEY=
