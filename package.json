{
  "name": "nuxt-jalali-minical",
  "version": "0.1.0",
  "description": "Minimal RTL-friendly Jalali calendar and date pickers for Nuxt 3",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./module": {
      "types": "./dist/module.d.ts",
      "import": "./dist/module.mjs"
    }
  },
  "scripts": {
    "build": "unbuild",
    "build:app": "nuxi generate playground",
    "build:vercel": "node scripts/vercel-build.mjs",
    "dev": "nuxi dev playground",
    "preview:app": "nuxi preview playground/.output",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "nuxt": "^3.10.0",
    "tailwindcss": ">=3.4.0",
    "vue": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nuxt/kit": "^3.10.0",
    "@nuxt/module-builder": "^0.8.4",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@types/node": "^22.0.0",
    "nuxt": "^3.10.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.5.0",
    "unbuild": "^2.0.0",
    "vitest": "^2.0.0",
    "vue": "^3.4.0"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-arabic": "^5.2.10",
    "@fontsource-variable/vazirmatn": "^5.2.8"
  }
}
