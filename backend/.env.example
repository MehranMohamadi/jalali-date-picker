# Required: pooled PostgreSQL connection; run migrations/001_initial.sql through 003_billing.sql first.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Required: random secret of at least 32 characters. Set the same value on the frontend server.
BUDGETYAR_API_TOKEN=CHANGE_ME
# Optional: legacy MCP account only. Browser cloud sync uses the signed-in account ID.
BUDGETYAR_USER_ID=owner
# Optional for direct browser access. The frontend cloud proxy does not need CORS.
BUDGETYAR_ALLOWED_ORIGIN=
# Development only: all four values are required to enable the payment simulator.
# Never enable on a production backend. No default price or subscription term is assumed.
BUDGETYAR_ENABLE_TEST_PAYMENTS=
BUDGETYAR_TEST_PRICE=
BUDGETYAR_TEST_CURRENCY=
BUDGETYAR_TEST_DURATION_DAYS=
